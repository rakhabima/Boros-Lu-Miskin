# Copy to .env in the project root on the VPS and fill in:
#   cp deploy/env.production.example .env && chmod 600 .env
# The domain is already filled in. Replace the change_me values and empty secrets.
# Generate secrets with:  openssl rand -base64 48
#
# This file is read by both bash (deploy.sh) and systemd, so put values that
# contain spaces in double quotes and keep comments on their own lines.

# --- Server ---
# The app binds to 127.0.0.1 only; Nginx or Caddy is the public entry.
PORT=3000
TZ=Asia/Jakarta

# --- Database (Postgres on this VPS) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=boros
DB_PASSWORD=change_me_long_random
DB_NAME=expense_tracker

# --- Sessions (required) ---
SESSION_SECRET=change_me_openssl_rand_base64_48
SESSION_TTL_SECONDS=1209600

# --- Origins (frontend and API are the same app) ---
FRONTEND_ORIGIN=https://boros.rakhbim-project.my.id
BACKEND_ORIGIN=https://boros.rakhbim-project.my.id
APP_BASE_URL=https://boros.rakhbim-project.my.id

# --- Google OAuth ---
# In Google Cloud Console, add BOTH redirect URIs to this client:
#   https://boros.rakhbim-project.my.id/api/auth/google/callback
#   https://boros.rakhbim-project.my.id/api/sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Sheets mirror ---
SHEETS_OAUTH_REDIRECT_URI=https://boros.rakhbim-project.my.id/api/sheets/callback
# openssl rand -base64 32   (changing it forces every user to reconnect)
SHEETS_TOKEN_ENC_KEY=
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
SHEETS_LEGACY_WEBHOOK_EMAILS=

# --- AI insights (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-thinking:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://boros.rakhbim-project.my.id
OPENROUTER_SITE_NAME="Boros Lu Miskin"

# --- Receipt reader (9router, OpenAI-compatible, base URL ends in /v1) ---
NINEROUTER_BASE_URL=https://your-9router-host/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=parse-struk
RECEIPT_DAILY_CAP=50
RECEIPT_HOURLY_LIMIT=30
SHORTCUT_INSTALL_URL=

# --- Misc ---
# Keep false until the Google consent screen is published and
# SHORTCUT_INSTALL_URL is set.
ONBOARDING_GATE_ENABLED=false
# Shown on /privacy. That page is built statically, so rebuild after changing it.
PRIVACY_CONTACT_EMAIL=
