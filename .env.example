# --- Database ---
# Local dev: discrete vars. Vercel/Neon/Supabase: set DATABASE_URL instead
# (it supersedes everything below) and use the POOLED connection string.
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=expense_tracker
DB_PASSWORD=your_db_password
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Sessions (required) ---
# Sessions and rate-limit counters are stored in Postgres, so no extra service.
SESSION_SECRET=replace_with_random_string
SESSION_TTL_SECONDS=1209600

# --- Google OAuth ---
# Authorized redirect URI must be <BACKEND_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AI ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-thinking:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Boros Lu Miskin

# --- Receipt reader (iPhone Shortcut -> /api/receipts) ---
# 9router on the VPS, OpenAI-compatible. Base URL ending in /v1; the app
# appends /chat/completions. Server-only, never sent to the client.
NINEROUTER_BASE_URL=https://your-vps.example.com/v1
NINEROUTER_API_KEY=your_9router_key
NINEROUTER_MODEL=parse-struk
# Max receipts read per user per day (Asia/Jakarta) and per hour.
RECEIPT_DAILY_CAP=50
RECEIPT_HOURLY_LIMIT=30
# iCloud link to the shared Shortcut, shown on /devices. Placeholder is fine.
SHORTCUT_INSTALL_URL=
# --- Google Sheets mirror (per user, see docs/google-sheets.md) ---
# Reuses GOOGLE_CLIENT_ID/SECRET above; add this redirect URI to that OAuth
# client. Key: `openssl rand -base64 32`. Changing the key forces every user
# to reconnect.
SHEETS_OAUTH_REDIRECT_URI=http://localhost:3000/api/sheets/callback
SHEETS_TOKEN_ENC_KEY=
# Legacy shared Apps Script webhook, ONLY for these emails (comma-separated).
# Everyone else never reaches it. Leave empty to disable.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
SHEETS_LEGACY_WEBHOOK_EMAILS=

# --- Onboarding gate ---
# true = new accounts must connect Google Sheets and an iPhone (/connect) before
# the dashboard. Keep false in production until the Google consent screen is
# published AND SHORTCUT_INSTALL_URL is set (the gate stays off without it).
ONBOARDING_GATE_ENABLED=false
# Public origin used for the /connect QR code; the request origin if empty.
APP_BASE_URL=

# --- Origins ---
# Frontend and API are the same Next.js app now, so these are the same value.
# BACKEND_ORIGIN is used to build the Google OAuth redirect_uri.
# Vercel: set both to https://<app>.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3000


# Server-side date math must run in the users' zone: expenses.created_at
# is TIMESTAMP without a zone and filtering now happens on the server.
TZ=Asia/Jakarta

# --- Tests only (never set in production) ---
# Sends every Google API call to a local mock; ignored when NODE_ENV=production.
# GOOGLE_API_MOCK_URL=http://127.0.0.1:4010
# Postgres login used by tests/harness.mjs for the integration tests
# (defaults: your OS user, no password).
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
