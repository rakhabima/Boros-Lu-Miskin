# --- Database ---
# Local dev: discrete vars. Vercel/Neon/Supabase: set DATABASE_URL instead
# (it supersedes everything below) and use the POOLED connection string.
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=expense_tracker
DB_PASSWORD=your_db_password
DB_PORT=5432
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Sessions (required) ---
# Sessions and rate-limit counters are stored in Postgres, so no extra service.
SESSION_SECRET=replace_with_random_string
SESSION_TTL_SECONDS=1209600

# --- Google OAuth ---
# Authorized redirect URI must be <BACKEND_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AI ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-thinking:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Boros Lu Miskin

# --- Origins ---
# Local dev: the two separate ports.
# Vercel: FRONTEND_ORIGIN=https://<app>.vercel.app
#         BACKEND_ORIGIN=https://<app>.vercel.app/api
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:4000

# --- Telegram (integration currently hidden in the UI) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_SECRET=
